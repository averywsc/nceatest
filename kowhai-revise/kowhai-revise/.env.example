# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in the footer
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Optional: forward feedback messages to a webhook (Slack, Discord, Formspree...).
# If empty, messages are appended to .data/feedback.jsonl (fine locally, not on serverless hosts).
FEEDBACK_WEBHOOK_URL=
